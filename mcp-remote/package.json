    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^24.9.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
