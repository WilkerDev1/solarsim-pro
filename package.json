{
  "name": "solarsim-pro",
  "private": true,
  "version": "1.3.5",
  "description": "Simulador Fotovoltaico Técnico-Económico Profesional",
  "author": "WilkerDev1",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node18 --external:electron --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --target=node18 --external:electron --outfile=dist-electron/preload.cjs",
    "electron:dev": "npm run build:electron && concurrently \"vite\" \"electron .\"",
    "electron:build": "npm run build && npm run build:electron && electron-builder",
    "build:win": "npm run build && npm run build:electron && electron-builder --win",
    "build:linux": "npm run build && npm run build:electron && electron-builder --linux"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.1"
  },
  "buildConfig": {
    "appId": "com.solarsim.pro",
    "productName": "SolarSim Pro"
  },
  "build": {
    "appId": "com.solarsim.pro",
    "productName": "SolarSim Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SolarSim Pro"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman",
        "tar.gz"
      ],
      "category": "Science",
      "maintainer": "WilkerDev1 <wilkerdev@github.com>",
      "synopsis": "Simulador Fotovoltaico Profesional",
      "description": "Simulador de proyectos solares fotovoltaicos con dimensionamiento, análisis financiero y exportación de propuestas PDF."
    },
    "publish": {
      "provider": "github",
      "owner": "WilkerDev1",
      "repo": "solarsim-pro"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true,
    "core-js@3.50.0": true
  }
}
