              "duplicate_model",
              "no_stock",
              "price_outlier",
              "unmatched_proposal_equipment"
            ]
          },
          "description": "Tipos de hallazgo a incluir; vacío u omitido, todos."
        }
      },
      "required": [],
      "additionalProperties": false
    }
