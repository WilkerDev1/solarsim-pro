  {
    "name": "create_proposal",
    "title": "Crear propuesta",
    "kind": "draft",
    "category": "proposals",
    "card": "proposal",
    "surfaces": [
      "app-assistant",
      "proposal-assistant",
      "mcp"
    ],
    "description": "Crea una propuesta nueva en modo Simple (Catálogo IA): equipos reales del catálogo con precio de la oferta preferida o la más barata disponible; sin oferta, el precio genérico del catálogo (avisado como precio genérico, sin proveedor); sin ninguno queda sin precio, nunca inventado. Indica doce consumos mensuales o un promedio. No abre la propuesta; usa open_proposal si el usuario quiere verla.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "company": {
          "type": "string",
          "maxLength": 200
        },
        "province": {
          "type": "string",
          "maxLength": 100,
          "description": "Provincia de República Dominicana."
        },
        "address": {
          "type": "string",
          "maxLength": 300
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "distributor": {
          "type": "string",
          "enum": [
            "EDEESTE",
            "EDESUR",
            "EDENORTE",
            "CEPM"
          ]
        },
        "tariffCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Código tarifario, p. ej. BTS1, BTS2, MTD."
        },
        "monthlyConsumptionKWh": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "description": "Doce consumos de enero a diciembre."
        },
        "averageMonthlyKWh": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000000
        },
        "targetCoveragePct": {
          "type": "number",
          "minimum": 1,
          "maximum": 300
        },
        "panels": {
          "type": "array",
          "maxItems": 6,
          "description": "Grupos de paneles del catálogo.",
          "items": {
            "type": "object",
            "properties": {
              "catalogItemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "ID real del catálogo."
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            },
            "required": [
              "catalogItemId",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "inverters": {
          "type": "array",
          "maxItems": 6,
          "description": "Grupos de inversores del catálogo.",
          "items": {
            "type": "object",
            "properties": {
              "catalogItemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "ID real del catálogo."
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            },
            "required": [
              "catalogItemId",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "batteries": {
          "type": "array",
          "maxItems": 6,
          "description": "Grupos de baterías del catálogo (opcional).",
          "items": {
            "type": "object",
            "properties": {
              "catalogItemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "ID real del catálogo."
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            },
            "required": [
              "catalogItemId",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "marginPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "description": "Recargo sobre costo en %, p. ej. 28."
        },
        "installationUnitPriceUSD": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000,
          "description": "Mano de obra USD/kWp."
        },
        "netMeteringRegime": {
          "type": "string",
          "enum": [
            "legacy_retention",
            "sie007_2026"
          ],
          "description": "Régimen de medición neta. Omítelo: las propuestas nuevas nacen en sie007_2026 (cargo por kWh inyectado); legacy_retention (retención % anterior) solo si el usuario lo pide."
        },
        "gridUseChargeDOPPerKWh": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Cargo por uso de la red en RD$/kWh inyectado. Omítelo para usar el de fábrica de la distribuidora (get_tariffs)."
        }
      },
      "required": [
        "clientName",
        "distributor",
        "tariffCode",
        "panels",
        "inverters"
      ],
      "additionalProperties": false
    }
  },
