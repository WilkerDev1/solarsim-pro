{
    admin off
    auto_https off
}

:80 {
    # Compresión moderna
    encode zstd gzip

    # Subdominios dedicados para la API de SolarSim
    @apiHost host api.solarsim.electsun.net solarsim.electsun.net api.electsun.net
    handle @apiHost {
        reverse_proxy solarsim-api:3000
    }

    # Enrutamiento de endpoints /api/* en cualquier host
    handle /api/* {
        reverse_proxy solarsim-api:3000
    }

    # Dominio principal / Landing page
    handle {
        respond "SolarSim Pro & Electsun Edge Gateway - Cloudflare Tunnel Connected" 200
    }
}
