{
    admin off
    auto_https off
}

:80 {
    # Compresión moderna
    encode zstd gzip

    # Subdominios de SolarSim / API
    @api host api.electsun.net solarsim.electsun.net api.eletcsun.net solarsim.eletcsun.net
    handle @api {
        reverse_proxy solarsim-api:3000
    }

    # Enrutamiento de endpoints /api/* en cualquier host
    handle /api/* {
        reverse_proxy solarsim-api:3000
    }

    # Landing page corporativa / Fallback
    handle {
        respond "SolarSim Pro & Electsun Edge Gateway - Cloudflare Tunnel Connected" 200
    }
}
